<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		App sandbox is OFF so the binary can use stdio for MCP framing.
		Calendar + Contacts entitlements are injected by Xcode's
		ENABLE_RESOURCE_ACCESS_CALENDARS / _CONTACTS build settings;
		do NOT duplicate them here — declaring iOS-style key names
		(personal-information.contacts) on macOS confuses TCC and
		causes silent denials.

		Reminders is the exception: Xcode 26's resource-access capability
		has no REMINDERS flag, so the entitlement must be declared here
		manually. Unlike contacts, there's no legacy-name vs new-name
		ambiguity to worry about — personal-information.reminders is
		simply the canonical macOS key.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.personal-information.reminders</key>
	<true/>
</dict>
</plist>
